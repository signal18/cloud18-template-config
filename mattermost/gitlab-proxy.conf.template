# Mattermost v11 Team Edition keeps GitLab sign-in on the server but no longer announces it to
# its clients: no GitLab button on the web page, the desktop app or the mobile app. This proxy
# adds EnableSignUpWithGitLab to the client config and passes everything else unchanged.
# The nginx image renders this file with envsubst: MATTERMOST_UPSTREAM is host:port of Mattermost,
# NGINX_LOCAL_RESOLVERS the container's DNS servers (set when NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1).
# The upstream is a variable so nginx resolves it again every 10 s: with a fixed name nginx resolves
# it once at start and keeps sending to the old address when Mattermost moves to another node.
# A location that sets a proxy_set_header drops the server-level ones: each location sets them all.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_tokens off;
  client_max_body_size 100m;
  proxy_http_version 1.1;
  proxy_read_timeout 600s;
  proxy_buffering off;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $mattermost_upstream http://${MATTERMOST_UPSTREAM};

  location = /api/v4/config/client {
    proxy_pass $mattermost_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Accept-Encoding "";
    proxy_set_header If-None-Match "";
    proxy_buffering on;
    sub_filter_types application/json;
    sub_filter_once on;
    sub_filter '"EnableSignUpWithEmail"' '"EnableSignUpWithGitLab":"true","EnableSignUpWithEmail"';
  }

  location / {
    proxy_pass $mattermost_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
